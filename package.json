{
  "name": "agritrace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "build": "node scripts/generate-pwa-icons.mjs && next build",
    "postbuild": "node scripts/postbuild-fix-nft-manifests.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:e2e:rc1": "playwright test --config=playwright.config.ts",
    "test:e2e:rc1:preview": "test -n \"$PREVIEW_BASE_URL\" && playwright test --config=playwright.config.ts",
    "seed": "tsx src/lib/supabase/seed.ts",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "seed:ministry": "tsx src/lib/supabase/seed-ministry-canonical.ts",
    "test:workflow": "tsx src/lib/workflow/__tests__/workflow.spec.ts && tsx src/lib/http/__tests__/security.spec.ts",
    "test:gis": "tsx src/lib/gis/__tests__/boundary.spec.ts",
    "test:rls:rc1": "node scripts/verify-rc1-rls-hardening.mjs",
    "test:rls:behavior": "bash scripts/run-rls-behavior.sh",
    "test:rls:p0": "PG_MIN_MESSAGES=notice bash scripts/run-p0-containment.sh",
    "test:workflow:parity": "tsx scripts/verify-workflow-transition-parity.ts",
    "test:identity:rc1": "node scripts/verify-workforce-identity.mjs",
    "test:private:rc1": "node scripts/verify-private-cutover.mjs",
    "audit:workforce:preflight": "tsx scripts/audit-workforce-preflight.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@react-pdf/renderer": "^4.5.1",
    "@react-three/fiber": "^9.8.0",
    "@sentry/nextjs": "^10.69.0",
    "@shadergradient/react": "^2.4.20",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-query": "^5.100.9",
    "@turf/area": "^7.3.5",
    "@turf/centroid": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@types/mapbox-gl": "^3.4.1",
    "camera-controls": "^3.1.2",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.9.0",
    "mapbox-gl": "^3.22.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.1",
    "recharts": "^3.8.1",
    "three": "^0.186.0",
    "three-stdlib": "^2.36.1",
    "workbox-background-sync": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "brace-expansion": "1.1.21",
    "dotenv": "^17.4.2",
    "eslint": "9.39.3",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.25",
    "postcss-import": "^15.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "@supabase/realtime-js": {
      "ws": "8.21.0"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.12"
    },
    "eslint": {
      "js-yaml": "4.3.2"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "postcss": "$postcss",
    "sharp": "0.35.4",
    "tsx": {
      "esbuild": "0.28.1"
    }
  }
}
